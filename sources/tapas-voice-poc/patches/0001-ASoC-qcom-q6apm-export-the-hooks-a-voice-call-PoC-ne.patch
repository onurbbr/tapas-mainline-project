From cd8f7204e394acd0b3d489cfc0867cacf84aa5e6 Mon Sep 17 00:00:00 2001
From: onurbbr <onurbuber@engineer.com>
Date: Sun, 8 Nov 2026 20:51:16 +0300
Subject: [PATCH 1/2] ASoC: qcom: q6apm: export the hooks a voice call PoC
 needs

AudioReach has no voice call support: the call graphs the DSP firmware
implements are described by the device's ACDB, and nothing in the kernel
opens them. Bringing them up experimentally is easier from a loadable
module than from q6apm itself, because snd-q6apm cannot be unloaded
without losing its GPR port. Export the three things such a module needs:

 - q6apm_send_cmd_sync(), so it can send its own GRAPH_OPEN, SET_CFG and
   GRAPH_START commands through the existing port;
 - q6apm_poc_get(), for the APM instance to send them on;
 - q6apm_poc_map_handle, which reports the handle of a shared memory
   region mapped with a reserved token (0x7ffe). The persistent voice
   calibration has to stay in DSP visible memory while registered, so it
   goes out of band, and the handle the DSP returns is only known here.

The token is far above the graph ids q6apm allocates, so the extra branch
in the map response cannot shadow a real graph.

Signed-off-by: onurbbr <onurbuber@engineer.com>
---
 sound/soc/qcom/qdsp6/q6apm.c | 21 +++++++++++++++++++++
 sound/soc/qcom/qdsp6/q6apm.h | 10 ++++++++++
 2 files changed, 31 insertions(+)

diff --git a/sound/soc/qcom/qdsp6/q6apm.c b/sound/soc/qcom/qdsp6/q6apm.c
index 6e8c4181a3a5..274d46b6b7f4 100644
--- a/sound/soc/qcom/qdsp6/q6apm.c
+++ b/sound/soc/qcom/qdsp6/q6apm.c
@@ -37,6 +37,21 @@ int q6apm_send_cmd_sync(struct q6apm *apm, const struct gpr_pkt *pkt,
 	return audioreach_send_cmd_sync(&gdev->dev, gdev, &apm->result, &apm->lock,
 					NULL, &apm->wait, pkt, rsp_opcode);
 }
+EXPORT_SYMBOL_GPL(q6apm_send_cmd_sync);
+
+/*
+ * Hooks for the voice call proof of concept. The PoC maps a shared memory
+ * region with Q6APM_POC_MAP_TOKEN and needs the handle the DSP hands back;
+ * it also needs the APM instance to send its own commands through.
+ */
+u32 q6apm_poc_map_handle;
+EXPORT_SYMBOL_GPL(q6apm_poc_map_handle);
+
+struct q6apm *q6apm_poc_get(void)
+{
+	return g_apm;
+}
+EXPORT_SYMBOL_GPL(q6apm_poc_get);
 
 static struct audioreach_graph *q6apm_get_audioreach_graph(struct q6apm *apm, uint32_t graph_id)
 {
@@ -979,6 +994,12 @@ static int apm_callback(const struct gpr_resp_pkt *data, void *priv, int op)
 		graph_id = hdr->token & APM_MMAP_TOKEN_GID_MASK;
 		is_pos_buf = hdr->token & APM_MMAP_TOKEN_MAP_TYPE_POS_BUF;
 
+		if (hdr->token == Q6APM_POC_MAP_TOKEN) {
+			q6apm_poc_map_handle = rsp->mem_map_handle;
+			wake_up(&apm->wait);
+			break;
+		}
+
 		info = idr_find(&apm->graph_info_idr, graph_id);
 		if (info) {
 			if (is_pos_buf)
diff --git a/sound/soc/qcom/qdsp6/q6apm.h b/sound/soc/qcom/qdsp6/q6apm.h
index 5cb51ca491dc..b3a560706732 100644
--- a/sound/soc/qcom/qdsp6/q6apm.h
+++ b/sound/soc/qcom/qdsp6/q6apm.h
@@ -150,6 +150,16 @@ int q6apm_unmap_memory_fixed_region(struct device *dev, unsigned int graph_id);
 int q6apm_send_cmd_sync(struct q6apm *apm, const struct gpr_pkt *pkt,
 			uint32_t rsp_opcode);
 
+/*
+ * Hooks for the voice call proof of concept, which lives in a loadable module
+ * so it can be reloaded without rebooting: snd-q6apm itself cannot be
+ * unloaded without losing its GPR port. A shared memory region mapped with
+ * Q6APM_POC_MAP_TOKEN reports its handle through q6apm_poc_map_handle.
+ */
+#define Q6APM_POC_MAP_TOKEN	0x7ffe
+extern u32 q6apm_poc_map_handle;
+struct q6apm *q6apm_poc_get(void);
+
 /* Callback for graph specific */
 struct audioreach_module *q6apm_find_module_by_mid(struct q6apm_graph *graph,
 						    uint32_t mid);
